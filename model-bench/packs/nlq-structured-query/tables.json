    "Document": [
      {
        "documentId": "fbcf1a1f87a249f484c0a8e351ca1e93",
        "sourceFormat": "text",
        "title": "NLQ-EVAL-01: Marlowe Robotics Founding"
      },
      {
        "documentId": "bf4033b2f59e4c558d1b33f312a74905",
        "sourceFormat": "text",
        "title": "NLQ-EVAL-02: Atlas-7 Product Launch"
      },
      {
        "documentId": "1d28673ef55a4e2ca321338a22155c90",
        "sourceFormat": "text",
        "title": "NLQ-EVAL-03: RoboWorks Summit Presentation"
      },
      {
        "documentId": "fd0ce90250694febbf9a74ac245c8536",
        "sourceFormat": "text",
        "title": "NLQ-EVAL-04: Cascade Logistics Partnership"
      },
      {
        "documentId": "bad1941b46844fc8a36afeb0b59ea6b7",
        "sourceFormat": "text",
        "title": "NLQ-EVAL-05: Thornfield Ventures Investment"
      },
      {
        "documentId": "ceb295aac0a94092be5ce5d0765df38d",
        "sourceFormat": "text",
        "title": "NLQ-EVAL-06: Brightline Systems Acquisition"
      },
      {
        "documentId": "0832036c407d4784a30e002649a98650",
        "sourceFormat": "text",
        "title": "NLQ-EVAL-07: Marlowe Robotics Employee Count (A)"
      },
      {
        "documentId": "35474077b0f84679a4197df46f296d90",
        "sourceFormat": "text",
        "title": "NLQ-EVAL-08: Marlowe Robotics Employee Count (B)"
      },
      {
        "documentId": "1bbad12c8ae14e108b98219288b721bd",
        "sourceFormat": "text",
        "title": "NLQ-EVAL-09: Swarm Coordination Research"
      },
      {
        "documentId": "4ca9da64dfe845979e4e6c46c4f342aa",
        "sourceFormat": "text",
        "title": "NLQ-EVAL-10: Competitor Landscape"
      },
      {
        "documentId": "47bc1eafbf0e4607aba4fb6d957276a5",
        "sourceFormat": "text",
        "title": "NLQ-EVAL-11: NovaGrid Software Platform"
      },
      {
        "documentId": "290dd4a876a849f683ab3af391cd7446",
        "sourceFormat": "text",
        "title": "NLQ-EVAL-12: Leadership Update"
      }
    ],
    "Chunk": [
      {
        "chunkId": "96c17d02741b4032a458ac3dddf2e8ec",
        "documentId": "fbcf1a1f87a249f484c0a8e351ca1e93",
        "seq": 0,
        "text": "Elena Ferro founded Marlowe Robotics in Austin, Texas in 2019. Devon Cole joined as co-founder and Chief Technology Officer three months later."
      },
      {
        "chunkId": "3daa5cd552c34f8181e16c77588204a8",
        "documentId": "bf4033b2f59e4c558d1b33f312a74905",
        "seq": 0,
        "text": "Marlowe Robotics launched the Atlas-7 warehouse robot on April 14, 2025. The Atlas-7 can lift pallets weighing up to 800 kilograms."
      },
      {
        "chunkId": "65a63812724f4883a78a29dd117b0674",
        "documentId": "1d28673ef55a4e2ca321338a22155c90",
        "seq": 0,
        "text": "Marlowe Robotics presented the Atlas-7 at the RoboWorks Summit 2025, held in Denver, Colorado. Devon Cole delivered the keynote demonstration."
      },
      {
        "chunkId": "a98bf0371aba4c17b93b760372ce7005",
        "documentId": "fd0ce90250694febbf9a74ac245c8536",
        "seq": 0,
        "text": "Marlowe Robotics partnered with Cascade Logistics in June 2025 to deploy Atlas-7 robots across Cascade Logistics' Denver distribution centers. Cascade Logistics is headquartered in Denver, Colorado."
      },
      {
        "chunkId": "b5e8157a7bd04fd8bdd47bf74e995cf4",
        "documentId": "bad1941b46844fc8a36afeb0b59ea6b7",
        "seq": 0,
        "text": "Thornfield Ventures led a Series B funding round for Marlowe Robotics in January 2026, investing 18 million dollars."
      },
      {
        "chunkId": "20da53614d284db08a7bc7d4c23f6f10",
        "documentId": "ceb295aac0a94092be5ce5d0765df38d",
        "seq": 0,
        "text": "Marlowe Robotics acquired Brightline Systems, a smaller robotics-software startup based in Boulder, Colorado, in March 2026."
      },
      {
        "chunkId": "5cb448b275c2436c8b5fee5115eb1737",
        "documentId": "0832036c407d4784a30e002649a98650",
        "seq": 0,
        "text": "As of March 2026, Marlowe Robotics has 62 employees."
      },
      {
        "chunkId": "c01a434de5d94ec98ad6ff524d43c8ca",
        "documentId": "35474077b0f84679a4197df46f296d90",
        "seq": 0,
        "text": "As of March 2026, Marlowe Robotics has 140 employees, following the Brightline Systems acquisition."
      },
      {
        "chunkId": "994467dcef8447258426db360b8d8c4c",
        "documentId": "1bbad12c8ae14e108b98219288b721bd",
        "seq": 0,
        "text": "Marlowe Robotics researches swarm coordination, a concept in decentralized robotics control that lets multiple Atlas-7 units navigate a warehouse without central routing."
      },
      {
        "chunkId": "38372997ff954b22a01c054ee7343300",
        "documentId": "4ca9da64dfe845979e4e6c46c4f342aa",
        "seq": 0,
        "text": "Marlowe Robotics competes with Vantage Automation in the warehouse-robotics market. Vantage Automation is headquartered in Seattle, Washington."
      },
      {
        "chunkId": "dccd2e483a0c416f94ff19454e6da9dc",
        "documentId": "47bc1eafbf0e4607aba4fb6d957276a5",
        "seq": 0,
        "text": "Marlowe Robotics develops NovaGrid, a fleet-management software platform that coordinates Atlas-7 robots in real time. NovaGrid was released in September 2025."
      },
      {
        "chunkId": "e899dd2bd9ec46399230a1247981c2f6",
        "documentId": "290dd4a876a849f683ab3af391cd7446",
        "seq": 0,
        "text": "In February 2026, Devon Cole was promoted from Chief Technology Officer to Chief Operating Officer at Marlowe Robotics. Priya Nandakumar joined Marlowe Robotics as the new Chief Technology Officer."
      }
    ]
  }
}
