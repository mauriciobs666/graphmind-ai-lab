  "data": {"items": "items.jsonl"},
  "sampling": {
    "seed": 20260911,
    "pairingKey": ["itemId"],
    "analysisUnit": "itemId"
  },
  "metrics": {
    "verdictMetrics": ["falseAdvanceRate", "falseSuspendRate"],
    "headlineMetric": null
  },
  "provenance": "PROVENANCE.md"
}
