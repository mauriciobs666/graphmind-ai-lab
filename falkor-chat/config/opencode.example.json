{
  "$schema": "https://opencode.ai/config.schema.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "qwen/qwen3-4b-2507": { "name": "Qwen3 4B 2507 (local)" },
        "text-embedding-qwen3-embedding-0.6b": { "name": "Qwen3 Embedding 0.6B (local)" }
      }
    },
    "lan-host": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (LAN host)",
      "options": {
        "baseURL": "http://192.168.0.69:1234"
      },
      "models": {
        "google/gemma-3n-e4b": { "name": "Gemma 3n-e4b (LAN)" }
      }
    },
    "openai": {
      "npm": "@ai-sdk/openai",
      "name": "OpenAI",
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-4o-mini": { "name": "GPT-4o mini" }
      }
    }
  }
}
