{
  "enabledMcpjsonServers": ["cypher"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/coordination-graph/hooks/post-tool-sync.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/coordination-graph/hooks/post-tool-sync.sh",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit(**)",
      "mcp__cypher__query"
    ],
    "ask": [
      "Bash(*FLUSHALL*)",
      "Bash(*FLUSHDB*)",
      "Bash(*GRAPH.DELETE*)",
      "Bash(*docker system prune*)",
      "Bash(*docker volume rm*)",
      "Bash(*docker volume prune*)",
      "Bash(*docker rm -f*)",
      "Bash(*down -v*)",
      "Bash(*down --volumes*)",
      "Bash(*pipeline.sh*--reset*)",
      "Edit(**/docs/BACKLOG.md)"
    ],
    "deny": [
      "Bash(git commit*claude.ai/code/session_*)",
      "Bash(gh pr create*claude.ai/code/session_*)",
      "Bash(gh pr edit*claude.ai/code/session_*)"
    ]
  }
}
