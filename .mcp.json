{
  "mcpServers": {
    "cypher": {
      "command": "bash",
      "args": ["-c", "exec \"$CLAUDE_PROJECT_DIR/cypher-mcp/docker-run.sh\""],
      "env": {
        "FALKORDB_HOST": "host.docker.internal",
        "FALKORDB_PORT": "6379"
      },
      "timeout": 60000
    },
    "falkor-chat-agent-team": {
      "type": "streamable-http",
      "url": "http://localhost:8200/mcp"
    },
    "ccg": {
      "command": "bash",
      "args": ["-c", "cd \"$CLAUDE_PROJECT_DIR/cpg\" && exec .venv/bin/python -m clients.mcp.server"],
      "env": {
        "CCG_SYSTEM": "graphmind-ai-lab",
        "CCG_FALKORDB_HOST": "127.0.0.1",
        "CCG_FALKORDB_PORT": "6390"
      },
      "timeout": 60000
    }
  }
}
