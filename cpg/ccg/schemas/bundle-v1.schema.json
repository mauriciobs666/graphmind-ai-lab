  "argPath": {
   "type": "string",
   "pattern": "^(?:a(?:0|[1-9][0-9]*)|recv|kw\\.(?:[^\\W0-9][\\w$]*|\\$[\\w$]*))(?:\\.(?:[^\\W0-9][\\w$]*|\\$[\\w$]*)|\\[\"(?:[^\"\\\\]|\\\\.)*\"\\]){0,3}(?!\\n)$"
  },
  "usePath": {
   "type": "string",
   "pattern": "^(?:(?:a(?:0|[1-9][0-9]*)|recv|kw\\.(?:[^\\W0-9][\\w$]*|\\$[\\w$]*))(?:\\.(?:[^\\W0-9][\\w$]*|\\$[\\w$]*)|\\[\"(?:[^\"\\\\]|\\\\.)*\"\\]){0,3}|ret(?:\\.(?:[^\\W0-9][\\w$]*|\\$[\\w$]*)|\\[\"(?:[^\"\\\\]|\\\\.)*\"\\]){0,3}|)(?!\\n)$"
  },
  "defPath": {
   "type": "string",
   "pattern": "^(?:p(?:0|[1-9][0-9]*)|recv|r)(?:\\.(?:[^\\W0-9][\\w$]*|\\$[\\w$]*)|\\[\"(?:[^\"\\\\]|\\\\.)*\"\\]){0,3}(?!\\n)$"
