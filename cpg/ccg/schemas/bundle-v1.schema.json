  },
  "path": {
   "type": "string",
   "pattern": "^(?!/)(?!.*//)(?!.*/(?!\\n)$)(?!(?:.*/)?\\.{1,2}(?:/|(?!\\n)$)).+(?!\\n)$"
  },
  "qname": {
   "type": "string",
   "pattern": "^.+::.+(?!\\n)$"
  },
  "lang": {
   "enum": [
    "python",
    "javascript",
