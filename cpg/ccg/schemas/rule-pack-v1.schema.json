{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:ccg:rule-pack-v1",
 "title": "ccg rule pack v1: one cpg/packs/<id>/pack.yaml, loaded as data",
 "description": "docs/plans/connected-code-graph-rule-pack-spec.md (format v1, section 1 and section 10). Unknown keys are rejected at every object. This schema is necessary but NOT sufficient: ccg/rulepack.py adds the RE2 subset of regex, the reason registry (ccg/registry/reasons.yaml), core-or-declared kinds, id = directory name, cross-references (lifting, query, slot), query joins, onUnknown defaults and the topic cells (O-16), signature samples and negatives, and the severity row derivation. A consumer that validates with this schema alone is not a validator.",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "packFormat": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9-]{0,39}$"
  },
  "version": {
   "type": "string",
   "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
  },
  "kind": {
   "enum": [
    "framework",
    "protocol",
    "data-store",
    "test-framework",
    "security",
    "infra-signatures",
    "severity"
   ]
  },
  "vocabVersion": {
   "const": "1.0"
  },
  "status": {
   "enum": [
    "paper"
   ]
  },
  "rules": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/rule"
   }
  },
  "mounts": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/mount"
   }
  },
  "liftings": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/lifting"
   }
  },
  "embedded": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/embedded"
   }
  },
  "launch": {
   "$ref": "#/$defs/launch"
  },
  "urlBindings": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/urlBinding"
   }
  },
  "vocab": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/vocab"
   }
  },
  "link": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/link"
   }
  },
  "queries": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/query"
   }
  },
  "runtimes": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/runtimeEntry"
   }
  },
  "signatures": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/signature"
   }
  },
  "formula": {
   "$ref": "#/$defs/formula"
  },
  "rows": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/row"
   }
  }
 },
 "required": [
  "packFormat",
  "id",
  "version",
  "kind",
  "vocabVersion"
 ],
 "allOf": [
  {
   "if": {
    "properties": {
     "kind": {
      "const": "severity"
     }
    },
    "required": [
     "kind"
    ]
   },
   "then": {
    "required": [
     "formula",
     "rows"
    ],
    "not": {
     "anyOf": [
      {
       "required": [
        "rules"
       ]
      },
      {
       "required": [
        "runtimes"
       ]
      },
      {
       "required": [
        "signatures"
       ]
      }
     ]
    }
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "const": "infra-signatures"
     }
    },
    "required": [
     "kind"
    ]
   },
   "then": {
    "required": [
     "runtimes",
     "signatures"
    ],
    "not": {
     "anyOf": [
      {
       "required": [
        "rules"
       ]
      },
      {
       "required": [
        "formula"
       ]
      },
      {
       "required": [
        "rows"
       ]
      }
     ]
    }
   }
  },
  {
   "if": {
    "properties": {
     "kind": {
      "enum": [
       "severity",
       "infra-signatures"
      ]
     }
    },
    "required": [
     "kind"
    ]
   },
   "else": {
    "not": {
     "anyOf": [
      {
       "required": [
        "formula"
       ]
      },
      {
       "required": [
        "rows"
       ]
      },
      {
       "required": [
        "runtimes"
       ]
      },
      {
       "required": [
        "signatures"
       ]
      }
     ]
    }
   }
  }
 ],
 "$defs": {
  "matcher": {
   "description": "spec 1.3: one matcher per field; a bare string means exact; a list is any-of. The RE2 subset of `regex` is validator code (ccg.rulepack).",
   "oneOf": [
    {
     "type": "string"
    },
    {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/matcher"
     }
    },
    {
     "$ref": "#/$defs/matcherObject"
    }
   ]
  },
  "matcherObject": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "exact": {
     "type": "string"
    },
    "template": {
     "type": "string"
    },
    "glob": {
     "type": "string"
    },
    "prefix": {
     "type": "string"
    },
    "basename": {
     "type": "string"
    },
    "regex": {
     "type": "string",
     "maxLength": 256
    },
    "ignoreCase": {
     "type": "boolean"
    }
   },
   "oneOf": [
    {
     "required": [
      "exact"
     ]
    },
    {
     "required": [
      "template"
     ]
    },
    {
     "required": [
      "glob"
     ]
    },
    {
     "required": [
      "prefix"
     ]
    },
    {
     "required": [
      "regex"
     ]
    },
    {
     "required": [
      "basename"
     ]
    }
   ],
   "dependentSchemas": {
    "ignoreCase": {
     "required": [
      "regex"
     ]
    }
   }
  },
  "argPath": {
   "type": "string",
   "pattern": "^(a\\d+|kw\\.[A-Za-z_]\\w*|recv)(\\.[A-Za-z_]\\w*)*$"
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9-]*$"
  },
  "kind": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9_]*$"
  },
  "fileRole": {
   "enum": [
    "primary",
    "example",
    "doc"
   ]
  },
  "verb": {
   "enum": [
    "GET",
    "HEAD",
    "POST",
    "PUT",
    "PATCH",
    "DELETE",
    "OPTIONS",
    "TRACE",
    "CONNECT",
    "*"
   ]
  },
  "emitStatus": {
   "enum": [
    "confirmed",
    "possible"
   ]
  },
  "args": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "arg": {
      "$ref": "#/$defs/argPath"
     },
     "value": {
      "$ref": "#/$defs/matcher"
     }
    },
    "required": [
     "arg"
    ]
   }
  },
  "decoratorClause": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "form": {
     "$ref": "#/$defs/matcher"
    },
    "name": {
     "$ref": "#/$defs/matcher"
    },
    "args": {
     "$ref": "#/$defs/args"
    },
    "target": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "kind": {
       "$ref": "#/$defs/matcher"
      },
      "name": {
       "$ref": "#/$defs/matcher"
      },
      "parentKind": {
       "$ref": "#/$defs/matcher"
      }
     },
     "minProperties": 1
    }
   },
   "minProperties": 1
  },
  "callClause": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "callee": {
     "$ref": "#/$defs/matcher"
    },
    "callKind": {
     "$ref": "#/$defs/matcher"
    },
    "resolution": {
     "$ref": "#/$defs/matcher"
    },
    "externalTarget": {
     "$ref": "#/$defs/matcher"
    },
    "args": {
     "$ref": "#/$defs/args"
    }
   },
   "minProperties": 1
  },
  "callsiteClause": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "callee": {
     "$ref": "#/$defs/matcher"
    },
    "callKind": {
     "$ref": "#/$defs/matcher"
    },
    "resolution": {
     "$ref": "#/$defs/matcher"
    },
    "externalTarget": {
     "$ref": "#/$defs/matcher"
    },
    "target": {
     "$ref": "#/$defs/matcher"
    },
    "args": {
     "$ref": "#/$defs/args"
    }
   },
   "minProperties": 1
  },
  "configClause": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "format": {
     "$ref": "#/$defs/matcher"
    },
    "keyPath": {
     "$ref": "#/$defs/matcher"
    },
    "bindValue": {
     "$ref": "#/$defs/matcher"
    }
   },
   "minProperties": 1
  },
  "launchClause": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "kind": {
     "$ref": "#/$defs/matcher"
    },
    "command": {
     "$ref": "#/$defs/matcher"
    },
    "args": {
     "$ref": "#/$defs/args"
    },
    "port": {
     "$ref": "#/$defs/matcher"
    },
    "envVar": {
     "$ref": "#/$defs/matcher"
    },
    "mountPath": {
     "$ref": "#/$defs/matcher"
    }
   },
   "minProperties": 1
  },
  "symbolClause": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "kind": {
     "$ref": "#/$defs/matcher"
    },
    "name": {
     "$ref": "#/$defs/matcher"
    },
    "qname": {
     "$ref": "#/$defs/matcher"
    },
    "parentKind": {
     "$ref": "#/$defs/matcher"
    }
   },
   "minProperties": 1
  },
  "markerClause": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "framework": {
     "$ref": "#/$defs/matcher"
    },
    "kindHint": {
     "$ref": "#/$defs/matcher"
    },
    "evidence": {
     "$ref": "#/$defs/matcher"
    }
   },
   "minProperties": 1
  },
  "liftedClause": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "lifting": {
     "$ref": "#/$defs/id"
    }
   },
   "required": [
    "lifting"
   ]
  },
  "subjectMatch": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "decorator": {
     "$ref": "#/$defs/decoratorClause"
    },
    "callsite": {
     "$ref": "#/$defs/callsiteClause"
    },
    "config": {
     "$ref": "#/$defs/configClause"
    },
    "launch": {
     "$ref": "#/$defs/launchClause"
    },
    "symbol": {
     "$ref": "#/$defs/symbolClause"
    },
    "marker": {
     "$ref": "#/$defs/markerClause"
    },
    "lifted": {
     "$ref": "#/$defs/liftedClause"
    },
    "query": {
     "$ref": "#/$defs/id"
    },
    "evidence": {
     "$ref": "#/$defs/matcher"
    }
   },
   "minProperties": 1,
   "maxProperties": 1
  },
  "match": {
   "oneOf": [
    {
     "$ref": "#/$defs/subjectMatch"
    },
    {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "anyOf": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/subjectMatch"
       }
      }
     },
     "required": [
      "anyOf"
     ]
    }
   ]
  },
  "scope": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "imports": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "module": {
        "$ref": "#/$defs/matcher"
       },
       "names": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      },
      "required": [
       "module"
      ]
     }
    },
    "path": {
     "$ref": "#/$defs/matcher"
    },
    "notPath": {
     "$ref": "#/$defs/matcher"
    },
    "role": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/fileRole"
     }
    }
   }
  },
  "expr": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "arg": {
     "$ref": "#/$defs/argPath"
    },
    "literal": {
     "type": "string"
    },
    "group": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9
    },
    "target": {
     "enum": [
      "name",
      "qname"
     ]
    },
    "config": {
     "enum": [
      "keyPath",
      "bindValue"
     ]
    },
    "field": {
     "type": "string",
     "minLength": 1
    },
    "yield": {
     "type": "string",
     "minLength": 1
    },
    "lifted": {
     "enum": [
      "url",
      "verb"
     ]
    },
    "firstOf": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/expr"
     }
    },
    "upper": {
     "const": true
    },
    "onUnknown": {
     "enum": [
      "drop",
      "partial",
      "runtime-built",
      "config-derived"
     ]
    },
    "default": {
     "type": "string"
    }
   },
   "oneOf": [
    {
     "required": [
      "arg"
     ]
    },
    {
     "required": [
      "literal"
     ]
    },
    {
     "required": [
      "group"
     ]
    },
    {
     "required": [
      "target"
     ]
    },
    {
     "required": [
      "config"
     ]
    },
    {
     "required": [
      "field"
     ]
    },
    {
     "required": [
      "yield"
     ]
    },
    {
     "required": [
      "lifted"
     ]
    },
    {
     "required": [
      "firstOf"
     ]
    }
   ],
   "dependentRequired": {
    "upper": [
     "group"
    ]
   }
  },
  "contractEmission": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "kind": {
     "$ref": "#/$defs/kind"
    },
    "key": {
     "type": "string",
     "minLength": 1
    },
    "keyForm": {
     "enum": [
      "literal",
      "glob",
      "regex",
      "template"
     ]
    },
    "status": {
     "$ref": "#/$defs/emitStatus"
    },
    "reason": {
     "type": "string",
     "minLength": 1
    }
   },
   "required": [
    "kind",
    "key"
   ]
  },
  "emission": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "provides": {
     "$ref": "#/$defs/contractEmission"
    },
    "consumes": {
     "$ref": "#/$defs/contractEmission"
    },
    "reads": {
     "$ref": "#/$defs/contractEmission"
    },
    "writes": {
     "$ref": "#/$defs/contractEmission"
    },
    "test": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "kind": {
       "enum": [
        "unit",
        "integration",
        "e2e"
       ]
      }
     },
     "required": [
      "kind"
     ]
    },
    "mark": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "as": {
       "enum": [
        "source",
        "sink",
        "sanitizer",
        "auth-check",
        "sensitive"
       ]
      },
      "class": {
       "type": "string",
       "minLength": 1
      }
     },
     "required": [
      "as",
      "class"
     ]
    },
    "finding": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "finding": {
       "enum": [
        "injection",
        "authorization",
        "configuration",
        "secrets"
       ]
      },
      "class": {
       "type": "string",
       "minLength": 1
      },
      "target": {
       "enum": [
        "config",
        "symbol"
       ]
      }
     },
     "required": [
      "finding",
      "class",
      "target"
     ]
    },
    "launches": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "target": {
       "type": "string",
       "minLength": 1
      }
     },
     "required": [
      "target"
     ]
    }
   },
   "minProperties": 1,
   "maxProperties": 1
  },
  "rule": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "id": {
     "$ref": "#/$defs/id"
    },
    "match": {
     "$ref": "#/$defs/match"
    },
    "scope": {
     "$ref": "#/$defs/scope"
    },
    "extract": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/expr"
     }
    },
    "emit": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/emission"
     }
    }
   },
   "required": [
    "id",
    "match",
    "emit"
   ]
  },
  "mount": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "id": {
       "$ref": "#/$defs/id"
      },
      "call": {
       "$ref": "#/$defs/callClause"
      },
      "scope": {
       "$ref": "#/$defs/scope"
      },
      "child": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "arg": {
         "$ref": "#/$defs/argPath"
        },
        "resolves": {
         "enum": [
          "factory-call"
         ]
        }
       },
       "required": [
        "arg",
        "resolves"
       ]
      },
      "prefix": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "arg": {
         "$ref": "#/$defs/argPath"
        },
        "default": {
         "type": "string"
        }
       },
       "required": [
        "arg"
       ]
      },
      "roots": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "call": {
          "$ref": "#/$defs/callClause"
         },
         "how": {
          "enum": [
           "app"
          ]
         },
         "notWith": {
          "type": "array",
          "items": {
           "$ref": "#/$defs/callClause"
          }
         }
        },
        "required": [
         "call",
         "how"
        ]
       }
      },
      "constructorPrefix": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "call": {
          "$ref": "#/$defs/callClause"
         },
         "arg": {
          "$ref": "#/$defs/argPath"
         }
        },
        "required": [
         "call",
         "arg"
        ]
       }
      },
      "unmounted": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "status": {
         "$ref": "#/$defs/emitStatus"
        },
        "reason": {
         "type": "string",
         "minLength": 1
        }
       },
       "required": [
        "status",
        "reason"
       ]
      },
      "recordConditions": {
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "call"
     ],
     "dependentRequired": {
      "prefix": [
       "child"
      ]
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "id": {
       "$ref": "#/$defs/id"
      },
      "kind": {
       "enum": [
        "class-decorator"
       ]
      },
      "decorator": {
       "$ref": "#/$defs/decoratorClause"
      },
      "scope": {
       "$ref": "#/$defs/scope"
      },
      "prefix": {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "arg": {
         "$ref": "#/$defs/argPath"
        }
       },
       "required": [
        "arg"
       ]
      },
      "recordConditions": {
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "kind",
      "decorator",
      "prefix"
     ]
    }
   ]
  },
  "lifting": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "id": {
     "$ref": "#/$defs/id"
    },
    "role": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "kind": {
       "$ref": "#/$defs/kind"
      },
      "slot": {
       "type": "string",
       "minLength": 1
      }
     },
     "required": [
      "kind",
      "slot"
     ]
    },
    "seeds": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "call": {
        "$ref": "#/$defs/callClause"
       },
       "arg": {
        "$ref": "#/$defs/argPath"
       }
      },
      "required": [
       "call",
       "arg"
      ]
