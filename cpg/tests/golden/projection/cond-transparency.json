    "def governed(keep, fn):",
    "    if keep is None:",
    "        return 0",
    "    try:",
    "        opened = fn()",
    "    except Exception:",
    "        return 1",
    "    if not opened:",
    "        return 2",
    "    return 3",
    "",
    "",
    "def nested_synth(keep, fn, fn2):",
    "    if keep is None:",
    "        return 0",
    "    try:",
    "        first = fn()",
    "        second = fn2(first)",
    "    except Exception:",
    "        return 1",
    "    return second",
    "",
    "",
    "def ungoverned(fn):",
    "    try:",
    "        opened = fn()",
    "    except Exception:",
    "        return 1",
    "    return opened",
    "",
    "",
