    "            env=env,",
    "            capture_output=True,",
    "            text=True,",
    "            timeout=60,",
    "        )",
    "        assert result.returncode == 0, (",
    "            f\"create_workspace.sh failed:\\nSTDOUT:\\n{result.stdout}\\nSTDERR:\\n{result.stderr}\"",
